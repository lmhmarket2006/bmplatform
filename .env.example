# ===== قاعدة البيانات (Railway PostgreSQL) =====
# على Railway: انسخ متغير DATABASE_URL من إضافة PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/bait_almusawwir"

# ===== المصادقة (NextAuth v5) =====
# ولّد مفتاحاً عبر: npx auth secret   أو   openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-me"
# على Railway اضبط هذا على رابط الدومين الكامل، مثال: https://your-app.up.railway.app
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== رفع الوسائط (Cloudinary) - اختياري =====
# الرفع يتم مباشرة من المتصفح (Unsigned). في لوحة Cloudinary:
# Settings > Upload > Upload presets > أنشئ preset بنوع Signing Mode = Unsigned
# ثم ضع اسم الـ preset واسم الـ cloud هنا. بدونها يعمل لصق الروابط يدوياً.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ===== البريد الإلكتروني (Nodemailer) - اختياري =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@baitalmusawwir.com"

# ===== إعدادات الدفع اليدوي (تظهر للطالب) =====
NEXT_PUBLIC_PAYMENT_BANK_NAME="مصرف الراجحي"
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME="أكاديمية بيت المصوّر"
NEXT_PUBLIC_PAYMENT_IBAN="SA0000000000000000000000"
